# ==========================================
# ReLife — Living Digital Product Passport
# Environment Variables Configuration
# ==========================================

# 1. Supabase Integration (Optional — App functions seamlessly in Demo & LocalStorage persistence mode if left blank)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. AI / LLM APIs (Optional — App uses built-in heuristic OCR and diagnostic expert system if not provided)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Application Deployment URL (Optional for metadata and QR links)
NEXT_PUBLIC_APP_URL=https://relifex.vercel.app
